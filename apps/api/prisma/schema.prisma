generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String @id
  name          String
  email         String @unique
  password_hash String
  role          String
  department    String?
  academic_year Int?
  semester      Int?
  created_at    DateTime @default(now())
  taught_courses CourseOffering[] @relation("OfferingTeacher")
  memberships   CourseMember[]
  lectures      CourseLecture[]

  @@index([role])
}

model CourseOffering {
  id            String @id
  code          String
  title         String
  department    String
  academic_year Int
  semester      Int
  teacher_id    String?
  teacher       User? @relation("OfferingTeacher", fields: [teacher_id], references: [id], onDelete: SetNull)
  members       CourseMember[]
  lectures      CourseLecture[]
  announcements CohortAnnouncement[]

  @@unique([code, department, academic_year, semester])
  @@index([department, academic_year, semester])
}

model CourseMember {
  id        Int @id @default(autoincrement())
  user_id   String
  course_id String
  user      User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  course    CourseOffering @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@unique([user_id, course_id])
}

model CourseLecture {
  id          String @id
  course_id   String
  teacher_id  String
  title       String
  description String
  content_url String
  created_at  DateTime @default(now())
  course      CourseOffering @relation(fields: [course_id], references: [id], onDelete: Cascade)
  teacher     User @relation(fields: [teacher_id], references: [id])

  @@index([course_id, created_at])
}

model CohortAnnouncement {
  id            String @id
  title         String
  body          String
  department    String
  academic_year Int
  semester      Int
  course_id     String?
  course        CourseOffering? @relation(fields: [course_id], references: [id], onDelete: Cascade)
  author_id     String
  author_name   String
  priority      String
  expires       String
  created_at    DateTime @default(now())

  @@index([department, academic_year, semester, created_at])
}

model Schedule {
  id         String @id
  course     String
  title      String
  day        String
  start_time String
  end_time   String
  room       String
  instructor String
  section    String

  @@index([day, start_time])
  @@index([course])
}

model Room {
  id          String    @id
  room_number String    @unique
  type        String
  capacity    Int
  equipment   String    // JSON-encoded string[]; SQLite has no array column type.
  floor       Int
  status      String
  bookings    Booking[]

  @@index([status, capacity])
}

model Booking {
  booking_id String @id
  booked_by  String
  date       String
  start_time String
  end_time   String
  purpose    String
  room_id    String
  room       Room   @relation(fields: [room_id], references: [id], onDelete: Cascade)

  @@index([room_id, date, start_time, end_time])
}

model Event {
  id            String         @id
  name          String
  description   String
  date          String
  start_time    String
  end_time      String
  end_date      String
  venue         String
  organizer     String
  capacity      Int
  registered    Int
  status        String
  registrations Registration[]

  @@index([date, start_time])
  @@index([status])
}

model Registration {
  id         Int    @id @default(autoincrement())
  student_id String
  name       String
  event_id   String
  event      Event  @relation(fields: [event_id], references: [id], onDelete: Cascade)

  @@unique([event_id, student_id])
}

model Announcement {
  id        String @id
  title     String
  body      String
  date      String
  priority  String
  posted_by String
  expires   String

  @@index([date])
  @@index([priority])
}

model Assignment {
  id                  String @id
  course              String
  course_title        String
  title               String
  description         String
  assigned_date       String
  deadline            String
  submission_platform String
  status              String
  marks               Float

  @@index([deadline])
  @@index([course, status])
}

model CampusUser {
  id          String       @id
  name        String
  email       String       @unique
  role        String
  semester    String?
  courses     Course[]     @relation("CourseTeacher")
  enrollments Enrollment[]
  lectures    Lecture[]

  @@index([role])
  @@index([semester])
}

model Course {
  id          String       @id
  code        String       @unique
  title       String
  semester    String
  teacher_id  String
  teacher     CampusUser   @relation("CourseTeacher", fields: [teacher_id], references: [id])
  enrollments Enrollment[]
  lectures    Lecture[]

  @@index([semester])
  @@index([teacher_id])
}

model Enrollment {
  id        Int        @id @default(autoincrement())
  user_id   String
  course_id String
  user      CampusUser @relation(fields: [user_id], references: [id], onDelete: Cascade)
  course    Course     @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@unique([user_id, course_id])
}

model Lecture {
  id          String     @id
  course_id   String
  teacher_id  String
  title       String
  description String
  content_url String
  created_at  DateTime   @default(now())
  course      Course     @relation(fields: [course_id], references: [id], onDelete: Cascade)
  teacher     CampusUser @relation(fields: [teacher_id], references: [id])

  @@index([course_id, created_at])
}

model SemesterAnnouncement {
  id         String   @id
  title      String
  body       String
  semester   String
  author_id  String
  author_name String
  author_role String
  priority   String
  created_at DateTime @default(now())
  expires    String

  @@index([semester, created_at])
}
